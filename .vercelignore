# Exclude large image directories from Vercel deployment
# These will be served from Google Cloud Storage instead
public/images/gallery/

# Exclude development files
.env
.env.local
*.log
.DS_Store
node_modules/
.vscode/

# Upload scripts and temporary files
scripts/upload-to-gcs.js
scripts/gcs-image-mapping.json
# Keep gcs-config.json for production image loading
!scripts/gcs-config.json
*.tmp
*.temp

# Git files
.git/
.gitignore

# README files for gallery structure
public/images/README.txt