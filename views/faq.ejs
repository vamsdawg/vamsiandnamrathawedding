<%- include('partials/head') %>
<%- include('partials/nav') %>
<% if (faqBg) { %>
<style>
  body.page-faq-bg { 
    background-image: url('<%= faqBg %>'); 
    background-size: cover; 
    background-position: center 30%; 
    background-repeat: no-repeat; 
    background-attachment: fixed; 
    font-family: 'Poppins', sans-serif;
  }
  
  /* Mobile FAQ Background Fix */
  @media (max-width: 768px) {
    body.page-faq-bg { 
      background: linear-gradient(135deg, #1a1a1a 0%, #0d0d0d 100%) !important;
    }
  }
</style>
<% } %>
<main class="container" style="margin:0 auto;">
    <div class="gallery-hero-spacer"></div>
    <section style="background:linear-gradient(to bottom, rgba(0,0,0,.65), rgba(0,0,0,.85));border-radius:18px;padding:32px 32px 40px;margin-top:24px;max-width:900px;margin-left:auto;margin-right:auto;">
            <h1 style="color:var(--accent);text-align:center;font-size:2.5em;margin:0 0 1em">Frequently Asked Questions</h1>

      <div style="color:var(--muted);font-size:1.05em;line-height:1.6">
        
        <!-- Hotel Block -->
        <div class="faq-item" style="margin-bottom:2.5em;">
          <h2 style="color:var(--accent);font-size:1.4em;margin:0 0 .7em;">Where can I stay for the events?</h2>
          <p>We have reserved a hotel block at the <strong>Crowne Plaza Norcross</strong> for both Friday night and Saturday night. A limited number of rooms are available at a special wedding rate. Please use the booking code below when reserving your room.</p>
          
          <p style="margin-bottom:.8em;"><a href="https://www.ihg.com/crowneplaza/hotels/us/en/find-hotels/select-roomrate?qDest=6050%20Peachtree%20Industrial%20Blvd.%20NW,%20Norcross,%20GA,%20US&qPt=CASH&qCiD=27&qCoD=1&qCiMy=012026&qCoMy=022026&qAdlt=1&qChld=0&qRms=1&qIta=99801505&qRtP=6CBARC&qAAR=6CBARC&qGrpCd=MYC&qSlH=atlpt&srb_u=1&qFS=false&qSrt=sBR&qBrs=6c.hi.ex.sb.ul.ic.cp.cw.in.vn.cv.rs.ki.kd.ma.sp.va.sp.re.vx.nd.sx.we.lx.rn.sn.sn.sn.sn.sn.nu.ge&qWch=0&qSmP=0&qRad=30&qRdU=mi&setPMCookies=false&qpMbw=0&qErm=false&qpMn=0&qRmFltr=" style="color:var(--accent);text-decoration:underline;" target="_blank">Hotel Block Link</a></p>
          
          <div class="faq-callout" style="background:#111;padding:16px 20px;border:1px solid #444;border-radius:10px;margin:16px 0;font-size:.95rem;">
            <p style="margin:0 0 .5em;"><strong>Hotel Block Deadline:</strong> 01/27/2026</p>
            <p style="margin:0 0 .5em;"><strong>Group Name:</strong> Mylarapu Chintalapati Wedding</p>
            <p style="margin:0;"><strong>Hotel Block Code:</strong> <span style="color:var(--accent);font-size:1.1em;font-weight:bold;">MYC</span></p>
          </div>
          
          <p>If you have any issues booking, please reach out to us and we'll be happy to help.</p>
        </div>

        <!-- Dress Code -->
        <div class="faq-item" style="margin-bottom:2.5em;">
          <h2 style="color:var(--accent);font-size:1.4em;margin:0 0 .7em;">What is the dress code?</h2>
          
          <div style="margin-bottom:1.5em;">
            <h3 style="color:#d9b166;font-size:1.15em;margin:0 0 .5em;">Ceremony:</h3>
            <p style="margin-bottom:.8em;">We encourage traditional Indian attire! <strong>Colors to avoid: white, black, red.</strong></p>
            <ul style="margin:.5em 0;padding-left:1.5em;line-height:1.8;">
              <li><strong>Women</strong> may wear a sari or lehenga. If you are wearing Western clothing, please wear skirts/dresses that are below the knees.</li>
              <li><strong>Men</strong> may wear a kurta and pyjama or business casual (khakis and a button down).</li>
            </ul>
            <p style="margin-top:1em;font-style:italic;color:#ccc;">Please keep in mind that the ceremony will be taking place in a temple. You may be asked to take your shoes off on the mandapam (wedding altar). The weather may be quite chilly so we encourage packing a shawl or light jacket.</p>
          </div>

          <div style="margin-bottom:1em;">
            <h3 style="color:#d9b166;font-size:1.15em;margin:0 0 .5em;">Reception:</h3>
            <p style="margin-bottom:.8em;">Time to go all out! <strong>Colors to avoid: Cream/white</strong></p>
            <ul style="margin:.5em 0;padding-left:1.5em;line-height:1.8;">
              <li><strong>Women</strong> may wear a sari or lehenga. You may also wear cocktail dresses if you prefer. Please make sure your attire is dance-proof!</li>
              <li><strong>Men</strong> may wear a suit or party-wear kurtas.</li>
              <li>Make sure your shoes are comfortable for dancing!</li>
            </ul>
          </div>

          <p style="margin-top:1.2em;font-style:italic;color:var(--accent);">If you have questions about attire or need help, please reach out to Namratha or Vamsi directly and we will be happy to help :)</p>
        </div>

        <!-- Ceremony Length -->
        <div class="faq-item" style="margin-bottom:2.5em;">
          <h2 style="color:var(--accent);font-size:1.4em;margin:0 0 .7em;">How long is the wedding ceremony in the morning?</h2>
          <p>The ceremony will take place from <strong>8AM-12PM</strong> and consists of several poojas and rituals to signify the union and bless the couple. Please refer to the "Ceremony" page of the website for details! We invite you to stay for the full ceremony! Lunch to follow.</p>
        </div>

        <!-- Children -->
        <div class="faq-item" style="margin-bottom:2.5em;">
          <h2 style="color:var(--accent);font-size:1.4em;margin:0 0 .7em;">Are children allowed?</h2>
          <p>Yes!</p>
        </div>

        <!-- Food -->
        <div class="faq-item" style="margin-bottom:2.5em;">
          <h2 style="color:var(--accent);font-size:1.4em;margin:0 0 .7em;">What type of food will be served?</h2>
          <ul style="margin:.5em 0;padding-left:0;list-style:none;line-height:2;">
            <li><strong style="color:#d9b166;">Breakfast:</strong> A light Indian breakfast with tea/coffee will be available in the morning at the ceremony venue for the wedding party and early guests. Please arrive early as breakfast will close by 8:30 am.</li>
            <li style="margin-top:.8em;"><strong style="color:#d9b166;">Lunch:</strong> A traditional South Indian lunch buffet (vegetarian)</li>
            <li style="margin-top:.8em;"><strong style="color:#d9b166;">Dinner:</strong> Traditional South Indian dinner buffet (non-vegetarian)</li>
          </ul>
          <p style="margin-top:1.2em;">If you have special dietary restrictions or food allergies, please email us at <a style="color:var(--accent)" href="mailto:nam.vamsi@gmail.com">nam.vamsi@gmail.com</a> and we will do our best to accommodate you.</p>
        </div>

        <!-- Live Stream -->
        <div class="faq-item" style="margin-bottom:2.5em;">
          <h2 style="color:var(--accent);font-size:1.4em;margin:0 0 .7em;">Is the wedding live streamed?</h2>
          <p>Yes, we will be live streaming the ceremony for relatives who live overseas and were unable to attend.</p>
        </div>

        <!-- Seating -->
        <div class="faq-item" style="margin-bottom:2.5em;">
          <h2 style="color:var(--accent);font-size:1.4em;margin:0 0 .7em;">What will the seating arrangement be?</h2>
          <p>There will be designated rows/seats for family and members of the wedding party. Otherwise, seating will be first-come first serve.</p>
        </div>

        <!-- Transportation -->
        <div class="faq-item" style="margin-bottom:2.5em;">
          <h2 style="color:var(--accent);font-size:1.4em;margin:0 0 .7em;">Is there transportation provided?</h2>
          <p style="margin-bottom:1em;"><strong>No shuttles provided</strong></p>
          
          <div style="margin-bottom:1em;">
            <p style="margin-bottom:.5em;"><strong style="color:#d9b166;">Wedding:</strong> Please follow the directions listed in the Event Schedule page. Once you arrive, you will be directed towards a parking area. The ceremony will be held in the Haveli Hall which is located across from the parking lot. Please follow the wedding sign boards.</p>
          </div>

          <div style="text-align:center;margin:1.5em 0;">
            <img src="https://storage.googleapis.com/vamsi-namratha-website-images/gallery/FAQ/faqpictemple.jpg" alt="Temple parking directions" style="max-width:100%;height:auto;border-radius:8px;border:2px solid rgba(217,177,102,0.3);">
          </div>

          <div>
            <p><strong style="color:#d9b166;">Reception:</strong> Please follow the directions listed in the Event Schedule page. Parking is available. Please follow wedding sign boards for directions.</p>
          </div>
        </div>

        <!-- Indoor/Outdoor -->
        <div class="faq-item" style="margin-bottom:2.5em;">
          <h2 style="color:var(--accent);font-size:1.4em;margin:0 0 .7em;">Is the wedding indoors or outdoors?</h2>
          <p>The wedding and reception will take place indoors. Please dress warmly.</p>
        </div>

        <!-- Photos -->
        <div class="faq-item" style="margin-bottom:0;">
          <h2 style="color:var(--accent);font-size:1.4em;margin:0 0 .7em;">What about photos?</h2>
          <p style="margin-bottom:1em;">We will have opportunities for guests to take photos with the couple after the ceremony and during the reception.</p>
          <p style="margin-bottom:1em;">Photos will be taken in groups (more information to come). Groups will be called over the speaker so please be mindful of when your group is called!</p>
          <p style="font-style:italic;color:#ccc;">We will not have extra time for photos after the ceremony if you miss your group as we need time to get ready for the reception afterwards.</p>
        </div>

      </div>
    </section>
    <div style="height:20vh"></div>
  </main>
<%- include('partials/footer') %>
