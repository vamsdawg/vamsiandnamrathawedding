<%- include('partials/head') %>
<%- include('partials/nav') %>
<% if (registryBg) { %>
<style>
  body.page-registry-bg { 
    background-image: url('<%= registryBg %>'); 
    background-size: cover; 
    background-position: center 30%; 
    background-repeat: no-repeat; 
    background-attachment: fixed; 
    font-family: 'Poppins', sans-serif;
  }
  
  /* Mobile Registry Background Fix */
  @media (max-width: 768px) {
    body.page-registry-bg { 
      background-image: url('<%= registryBg %>') !important;
      background-size: cover !important;
      background-position: center !important;
      background-attachment: scroll !important;
    }
  }
</style>
<% } %>
<style>
  .registry-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    max-width: 900px;
    margin: 40px auto 0;
    padding: 0 20px;
  }
  
  .registry-card {
    background: linear-gradient(to bottom, rgba(0,0,0,.6), rgba(0,0,0,.85));
    border-radius: 12px;
    padding: 32px 28px;
    text-align: center;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  
  .registry-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(217, 177, 102, 0.2);
  }
  
  .registry-card h2 {
    color: var(--accent);
    font-family: "Playfair Display", Georgia, serif;
    font-size: 1.8em;
    margin: 0 0 16px;
  }
  
  .registry-card p {
    color: var(--muted);
    line-height: 1.6;
    margin: 0 0 24px;
    font-size: 1.05em;
  }
  
  .registry-btn {
    display: inline-block;
    background: var(--accent);
    color: #222;
    text-decoration: none;
    padding: 12px 28px;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.95em;
    letter-spacing: 0.05em;
    transition: background 0.3s ease, transform 0.2s ease;
  }
  
  .registry-btn:hover {
    background: #e8c276;
    transform: scale(1.05);
  }
  
  @media (max-width: 768px) {
    .registry-grid {
      grid-template-columns: 1fr;
      gap: 20px;
      margin: 32px auto 0;
      padding: 0 16px;
    }
    
    .registry-card {
      padding: 28px 24px;
    }
    
    .registry-card h2 {
      font-size: 1.6em;
    }
    
    .registry-card p {
      font-size: 1em;
    }
  }
</style>
<main class="container" style="margin:0 auto;">
  <div class="gallery-hero-spacer"></div>
  <section style="background:linear-gradient(to bottom, rgba(0,0,0,.6), rgba(0,0,0,.85));border-radius:18px;padding:40px 40px 48px;max-width:800px;margin:0 auto;">
    <h1 style="color:var(--accent);text-align:center;font-size:2.6em;margin:0 0 .9em;">Registry</h1>
    <p style="color:var(--muted);line-height:1.6;text-align:center;margin:0 0 2em;font-size:1.1em;">Your presence is the greatest gift. If you would like to contribute to our next chapter, we have included a few options for you below.</p>
  </section>
  
  <div class="registry-grid">
    <!-- Honeyfund -->
    <div class="registry-card">
      <h2>Honeyfund</h2>
      <p>Help us create unforgettable memories on our honeymoon adventure</p>
      <a href="https://www.honeyfund.com/site/mylarapu-chintalapati-02-28-2026" target="_blank" rel="noopener noreferrer" class="registry-btn">Visit Our Honeyfund</a>
    </div>
    
    <!-- Amazon Registry -->
    <div class="registry-card">
      <h2>Amazon Registry</h2>
      <p>Find home essentials and items for our new life together</p>
      <a href="https://www.amazon.com/wedding/guest-view/7DIOYVVW4NHM" target="_blank" rel="noopener noreferrer" class="registry-btn">View Amazon Registry</a>
    </div>
    
    <!-- Pottery Barn -->
    <div class="registry-card">
      <h2>Pottery Barn</h2>
      <p>View our favorite selection of home decor items</p>
      <a href="https://www.potterybarn.com/registry/qmdwkcztsv/registry-list.html" target="_blank" rel="noopener noreferrer" class="registry-btn">Shop Pottery Barn</a>
    </div>
    
    <!-- Crate and Barrel -->
    <div class="registry-card">
      <h2>Crate and Barrel</h2>
      <p>Here are a few of our kitchen favorites</p>
      <a href="https://www.crateandbarrel.com/gift-registry/namratha-mylarapu-and-vamsi-chintalapati/r7475811" target="_blank" rel="noopener noreferrer" class="registry-btn">Browse Crate and Barrel</a>
    </div>
  </div>
  
  <div style="height:10vh"></div>
</main>
<%- include('partials/footer') %>
