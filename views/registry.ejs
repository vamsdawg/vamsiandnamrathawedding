<%- include('partials/head') %>
<%- include('partials/nav') %>
<style>
  body.page-registry-bg { 
    background-image: url('https://storage.googleapis.com/vamsi-namratha-website-images/gallery/Registry/registrybackground1.jpg'); 
    background-size: cover; 
    background-position: center 30%; 
    background-repeat: no-repeat; 
    background-attachment: fixed; 
    font-family: 'Poppins', sans-serif;
  }
  
  /* Mobile Registry Background Fix */
  @media (max-width: 768px) {
    body.page-registry-bg { 
      background: linear-gradient(135deg, #1a1a1a 0%, #0d0d0d 100%) !important;
    }
  }
</style>
<main class="container" style="margin:0 auto;">
  <div class="gallery-hero-spacer"></div>
  <section style="background:linear-gradient(to bottom, rgba(0,0,0,.65), rgba(0,0,0,.85));border-radius:18px;padding:40px 40px 48px;max-width:900px;margin:24px auto 0;">
    <h1 style="color:var(--accent);text-align:center;font-size:2.6em;margin:0 0 .9em;">Registry</h1>
    <p style="color:var(--muted);line-height:1.6;text-align:center;margin:0 0 2.5em;font-size:1.1em;">Your presence is the greatest gift. If you would like to contribute to our next chapter, we have included a few options for you below.</p>
    
    <div style="display:grid;grid-template-columns:repeat(2, 1fr);gap:24px;margin-top:32px;">
      <!-- Honeyfund -->
      <div style="background:rgba(0,0,0,.4);border:1px solid rgba(217,177,102,.3);border-radius:12px;padding:28px 24px;text-align:center;">
        <h2 style="color:var(--accent);font-family:'Playfair Display', Georgia, serif;font-size:1.7em;margin:0 0 12px;">Honeyfund</h2>
        <p style="color:var(--muted);line-height:1.6;margin:0 0 20px;font-size:1em;">Help us create unforgettable memories on our honeymoon adventure</p>
        <a href="https://www.honeyfund.com/site/mylarapu-chintalapati-02-28-2026" target="_blank" rel="noopener noreferrer" style="display:inline-block;background:var(--accent);color:#222;text-decoration:none;padding:12px 28px;border-radius:999px;font-weight:600;font-size:0.95em;letter-spacing:0.05em;transition:all 0.3s ease;">Visit Our Honeyfund</a>
      </div>
      
      <!-- Amazon Registry -->
      <div style="background:rgba(0,0,0,.4);border:1px solid rgba(217,177,102,.3);border-radius:12px;padding:28px 24px;text-align:center;">
        <h2 style="color:var(--accent);font-family:'Playfair Display', Georgia, serif;font-size:1.7em;margin:0 0 12px;">Amazon Registry</h2>
        <p style="color:var(--muted);line-height:1.6;margin:0 0 20px;font-size:1em;">Find home essentials and items for our new life together</p>
        <a href="https://www.amazon.com/wedding/guest-view/7DIOYVVW4NHM" target="_blank" rel="noopener noreferrer" style="display:inline-block;background:var(--accent);color:#222;text-decoration:none;padding:12px 28px;border-radius:999px;font-weight:600;font-size:0.95em;letter-spacing:0.05em;transition:all 0.3s ease;">View Amazon Registry</a>
      </div>
      
      <!-- Pottery Barn -->
      <div style="background:rgba(0,0,0,.4);border:1px solid rgba(217,177,102,.3);border-radius:12px;padding:28px 24px;text-align:center;">
        <h2 style="color:var(--accent);font-family:'Playfair Display', Georgia, serif;font-size:1.7em;margin:0 0 12px;">Pottery Barn</h2>
        <p style="color:var(--muted);line-height:1.6;margin:0 0 20px;font-size:1em;">View our favorite selection of home decor items</p>
        <a href="https://www.potterybarn.com/registry/qmdwkcztsv/registry-list.html" target="_blank" rel="noopener noreferrer" style="display:inline-block;background:var(--accent);color:#222;text-decoration:none;padding:12px 28px;border-radius:999px;font-weight:600;font-size:0.95em;letter-spacing:0.05em;transition:all 0.3s ease;">Shop Pottery Barn</a>
      </div>
      
      <!-- Crate and Barrel -->
      <div style="background:rgba(0,0,0,.4);border:1px solid rgba(217,177,102,.3);border-radius:12px;padding:28px 24px;text-align:center;">
        <h2 style="color:var(--accent);font-family:'Playfair Display', Georgia, serif;font-size:1.7em;margin:0 0 12px;">Crate and Barrel</h2>
        <p style="color:var(--muted);line-height:1.6;margin:0 0 20px;font-size:1em;">Here are a few of our kitchen favorites</p>
        <a href="https://www.crateandbarrel.com/gift-registry/namratha-mylarapu-and-vamsi-chintalapati/r7475811" target="_blank" rel="noopener noreferrer" style="display:inline-block;background:var(--accent);color:#222;text-decoration:none;padding:12px 28px;border-radius:999px;font-weight:600;font-size:0.95em;letter-spacing:0.05em;transition:all 0.3s ease;">Browse Crate and Barrel</a>
      </div>
    </div>
    
    <style>
      @media (max-width: 768px) {
        div[style*="grid-template-columns"] {
          grid-template-columns: 1fr !important;
          gap: 20px !important;
        }
      }
    </style>
  </section>
  <div style="height:20vh"></div>
</main>
<%- include('partials/footer') %>
