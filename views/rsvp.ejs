<%- include('partials/head') %>
<%- include('partials/nav') %>

<style>
        body {
            margin: 0;
            padding: 0;
            min-height: 100vh;
            background-image: url('<%= rsvpBg %>');
            background-size: cover;
            background-position: center 30%;
            background-repeat: no-repeat;
            background-attachment: fixed;
            font-family: 'Poppins', sans-serif;
        }

        .rsvp-background {
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 2rem;
            padding-top: 3rem;
            box-sizing: border-box;
        }

        .rsvp-container {
    background: rgba(0, 0, 0, 0.75);
    border-radius: 15px;
    padding: 2.5rem;
    max-width: 500px;
    width: 100%;
    backdrop-filter: blur(10px);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
  }
  
  .form-group {
    margin-bottom: 1.5rem;
  }
  
  .form-label {
    display: block;
    color: #fff;
    font-weight: bold;
    margin-bottom: 0.5rem;
  }
  
  .form-input, .form-select {
    width: 100%;
    padding: 12px;
    border-radius: 8px;
    border: 1px solid #444;
    background: rgba(17, 17, 17, 0.9);
    color: #fff;
    font-size: 1rem;
    box-sizing: border-box;
  }
  
  .form-input:focus, .form-select:focus {
    outline: none;
    border-color: #d9b166;
    box-shadow: 0 0 5px rgba(217, 177, 102, 0.3);
  }
  
  .search-results {
    background: rgba(34, 34, 34, 0.95);
    border: 1px solid #444;
    border-radius: 8px;
    max-height: 200px;
    overflow-y: auto;
    margin-top: 0.5rem;
    display: none;
  }
  
  .search-item {
    padding: 12px;
    color: #fff;
    cursor: pointer;
    border-bottom: 1px solid #444;
  }
  
  .search-item:hover {
    background: rgba(217, 177, 102, 0.2);
  }
  
  .search-item:last-child {
    border-bottom: none;
  }
  
  .submit-btn {
    width: 100%;
    padding: 15px;
    background: #d9b166;
    color: #000;
    border: none;
    border-radius: 8px;
    font-size: 1.1rem;
    font-weight: bold;
    cursor: pointer;
    transition: background 0.3s ease;
  }
  
  .submit-btn:hover {
    background: #c19b4d;
  }
  
  /* Mobile RSVP Responsive Styles */
  @media (max-width: 768px) {
    body {
      background-image: url('<%= rsvpBg %>') !important;
      background-size: cover !important;
      background-position: center !important;
      background-attachment: scroll !important;
    }
    
    .rsvp-background {
      padding: 1rem;
      padding-top: 2rem;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
    }
    
    .rsvp-container {
      padding: 1.5rem;
      margin: 0 auto;
      width: 100%;
      max-width: 400px;
      border-radius: 12px;
      position: relative;
      top: -2rem; /* Adjust to center better with nav */
    }
    
    .rsvp-container h1 {
      font-size: 2rem !important;
      margin-bottom: 1.5rem !important;
    }
    
    .search-container input,
    .form-group input,
    .form-group select,
    .form-group textarea {
      font-size: 16px !important; /* Prevents zoom on iOS */
      padding: 12px !important;
    }
    
    .search-results {
      max-height: 200px !important;
    }
    
    .submit-btn {
      padding: 14px 20px !important;
      font-size: 16px !important;
      width: 100%;
      margin-top: 1rem;
    }
  }
  
  @media (max-width: 480px) {
    .rsvp-background {
      padding: 0.5rem;
      padding-top: 1.5rem;
    }
    
    .rsvp-container {
      padding: 1rem;
      border-radius: 8px;
      max-width: 350px;
      top: -1rem;
    }
    
    .rsvp-container h1 {
      font-size: 1.8rem !important;
    }
    
    .search-container input,
    .form-group input,
    .form-group select,
    .form-group textarea {
      padding: 10px !important;
    }
  }
</style>

<div class="rsvp-background">
  <div class="rsvp-container">
    <h1 style="color: #fff; text-align: center; margin: 0 0 2rem 0; font-size: 2.5rem;">RSVP</h1>
    
    <% if (typeof rsvpLocked !== 'undefined' && rsvpLocked) { %>
      <div style="background: rgba(217, 177, 102, 0.2); color: #d9b166; padding: 1.5rem; border-radius: 8px; margin-bottom: 1.5rem; border: 1px solid #d9b166; text-align: center;">
        <h2 style="margin: 0 0 0.5rem 0; font-size: 1.5rem;">RSVPs Are Now Closed</h2>
        <p style="margin: 0;">Thank you for your interest! If you need to make changes to your RSVP, please contact us directly.</p>
      </div>
    <% } %>
    
    <% if (typeof error !== 'undefined') { %>
      <div style="background: rgba(255, 0, 0, 0.2); color: #ff6b6b; padding: 1rem; border-radius: 8px; margin-bottom: 1.5rem; border: 1px solid #ff6b6b;">
        <%= error %>
      </div>
    <% } %>
    
    <form method="post" id="rsvpForm" <% if (typeof rsvpLocked !== 'undefined' && rsvpLocked) { %>style="display: none;"<% } %>>
      <input type="hidden" name="guestId" id="selectedGuestId">
      
      <!-- Guest Search - Always Visible -->
      <div class="form-group">
        <label class="form-label">Search for your family name:</label>
        <input type="text" id="guestSearch" class="form-input" placeholder="Start typing your last name..." autocomplete="off" autocorrect="off" autocapitalize="words" <% if (typeof rsvpLocked !== 'undefined' && rsvpLocked) { %>disabled<% } %>>
        <div id="searchResults" class="search-results"></div>
      </div>
      
      <!-- Rest of form - Hidden until family selected -->
      <div id="rsvpFormFields" style="display: none;">
        <!-- Selected Family Display -->
        <div class="form-group">
          <div id="selectedFamily" style="background: rgba(217, 177, 102, 0.2); padding: 1rem; border-radius: 8px; border: 1px solid rgba(217, 177, 102, 0.5);">
            <h3 style="color: #d9b166; margin: 0; font-size: 1.2rem;" id="familyName">Selected Family</h3>
          </div>
        </div>

        <!-- Number of Adults -->
        <div class="form-group">
          <label class="form-label">Number of Guests Attending:</label>
          <input type="number" name="adultsAttending" class="form-input" min="0" max="10" required>
        </div>

        <!-- Email Address -->
        <div class="form-group">
          <label class="form-label">Email Address:</label>
          <input type="email" name="email" id="emailInput" class="form-input" placeholder="your.email@example.com" required>
        </div>
        
        <!-- Event Selection - Dropdown with multiple options -->
        <div class="form-group">
          <label class="form-label">Event Selection:</label>
          <select name="attendingWedding" class="form-select" required style="margin-bottom: 0.5rem;">
            <option value="">Wedding Ceremony?</option>
            <option value="yes">Yes, attending Wedding Ceremony</option>
            <option value="no">No, not attending Wedding Ceremony</option>
          </select>
          <select name="attendingReception" class="form-select" required>
            <option value="">Reception?</option>
            <option value="yes">Yes, attending Reception</option>
            <option value="no">No, not attending Reception</option>
          </select>
        </div>
        
        <!-- Hotel Block -->
        <div class="form-group">
          <label class="form-label">Using Hotel Block?</label>
          <select name="usingHotelBlock" class="form-select" required>
            <option value="">Please select...</option>
            <option value="yes">Yes</option>
            <option value="no">No</option>
          </select>
        </div>
        
        <!-- Message -->
        <div class="form-group">
          <label class="form-label">Message (optional):</label>
          <textarea name="message" class="form-input" rows="4" placeholder="Please include the names of all guests attending from your party..."></textarea>
        </div>
        
        <button type="submit" class="submit-btn">Send RSVP</button>
      </div>
    </form>
  </div>
</div>

<script>
  const searchInput = document.getElementById('guestSearch');
  const searchResults = document.getElementById('searchResults');
  const rsvpForm = document.getElementById('rsvpForm');
  let searchTimeout;
  let guestSelected = false; // Track if a guest has been selected
  const rsvpLocked = <%= typeof rsvpLocked !== 'undefined' && rsvpLocked ? 'true' : 'false' %>;

  // Prevent any form interaction if RSVPs are locked
  if (rsvpLocked) {
    rsvpForm.addEventListener('submit', function(e) {
      e.preventDefault();
      alert('RSVPs are now closed. Please contact us if you need to make changes.');
      return false;
    });
    
    // Prevent search input from being used
    searchInput.addEventListener('focus', function(e) {
      e.preventDefault();
      this.blur();
    });
    
    searchInput.addEventListener('input', function(e) {
      e.preventDefault();
      this.value = '';
    });
    
    // Block any attempts to enable the form
    return; // Exit script early
  }

  // Prevent form submission if guest not selected
  rsvpForm.addEventListener('submit', function(e) {
    if (!guestSelected) {
      e.preventDefault();
      alert('Please select a family name from the search results first.');
      searchInput.focus();
      return false;
    }
  });

  // Clear selection if user starts typing again
  searchInput.addEventListener('focus', function() {
    if (guestSelected) {
      const confirmChange = confirm('Do you want to search for a different family?');
      if (confirmChange) {
        resetForm();
      } else {
        this.blur(); // Remove focus if they don't want to change
      }
    }
  });

  searchInput.addEventListener('input', function() {
    clearTimeout(searchTimeout);
    const query = this.value.trim();
    
    // Reset guest selection when typing
    if (guestSelected) {
      resetForm();
    }
    
    if (query.length < 2) {
      searchResults.style.display = 'none';
      return;
    }

    searchTimeout = setTimeout(() => {
      performSearch(query, 0); // Start with 0 retries
    }, 300);
  });

  async function performSearch(query, retryCount = 0) {
    const maxRetries = 2;
    
    try {
      const response = await fetch(`/rsvp/search-guests?q=${encodeURIComponent(query)}`);
      
      if (!response.ok) {
        if (response.status === 403) {
          // RSVPs are locked
          searchResults.innerHTML = '<div class="search-item" style="color: #d9b166;">RSVPs are now closed.</div>';
          searchResults.style.display = 'block';
          return;
        }
        throw new Error(`HTTP ${response.status}: ${response.statusText}`);
      }
      
      const data = await response.json();
      
      // Check if response has error field or locked status
      if (data.locked || data.error) {
        searchResults.innerHTML = '<div class="search-item" style="color: #d9b166;">RSVPs are now closed.</div>';
        searchResults.style.display = 'block';
        return;
      }
      
      // Handle results array
      const guests = Array.isArray(data) ? data : (data.results || []);
      displaySearchResults(guests);
      
    } catch (err) {
      console.error('Search error (attempt ' + (retryCount + 1) + '):', err.message);
      
      // Retry logic for connection issues
      if (retryCount < maxRetries && (err.message.includes('Failed to fetch') || err.message.includes('503') || err.message.includes('Database'))) {
        console.log('Retrying search in 1 second...');
        searchResults.innerHTML = '<div class="search-item">Reconnecting... Please wait.</div>';
        searchResults.style.display = 'block';
        
        setTimeout(() => {
          performSearch(query, retryCount + 1);
        }, 1000);
      } else {
        // Final error display
        searchResults.innerHTML = '<div class="search-item" style="color: #ff6b6b;">Search failed. Please refresh the page and try again.</div>';
        searchResults.style.display = 'block';
      }
    }
  }

  function displaySearchResults(guests) {
    if (guests.length === 0) {
      searchResults.innerHTML = '<div class="search-item">No families found. Please check the spelling.</div>';
      searchResults.style.display = 'block';
      return;
    }

    const html = guests.map(guest => {
      const status = guest.rsvpSubmitted ? ' (Already responded)' : '';
      return `<div class="search-item" onclick="selectGuest('${guest.guestId}', '${guest.name}', ${guest.rsvpSubmitted}, ${guest.invitedCount})">${guest.name}${status}</div>`;
    }).join('');

    searchResults.innerHTML = html;
    searchResults.style.display = 'block';
  }

  function selectGuest(guestId, guestName, alreadySubmitted, invitedCount) {
    if (alreadySubmitted) {
      const confirmUpdate = confirm(`${guestName} has already submitted an RSVP. Do you want to update their response?`);
      if (!confirmUpdate) {
        searchResults.style.display = 'none';
        return;
      }
    }
    
    document.getElementById('selectedGuestId').value = guestId;
    searchInput.value = guestName;
    searchResults.style.display = 'none';
    guestSelected = true; // Mark as selected
    
    // Blur the input to hide keyboard on mobile
    searchInput.blur();
    
    // Show the family name in the selected family box
    document.getElementById('familyName').textContent = guestName;
    
    // Update the max value for adults attending input
    const adultsInput = document.querySelector('input[name="adultsAttending"]');
    adultsInput.max = invitedCount;
    adultsInput.placeholder = `Max ${invitedCount} guests`;
    
    // Update the label to show the invited count
    const adultsLabel = adultsInput.previousElementSibling;
    adultsLabel.textContent = `Number of Guests Attending (Max ${invitedCount}):`;
    
    // Show the rest of the form
    document.getElementById('rsvpFormFields').style.display = 'block';
    
    // Show different submit button text if updating
    const submitBtn = document.querySelector('.submit-btn');
    if (alreadySubmitted) {
      submitBtn.textContent = 'Update RSVP';
      submitBtn.style.background = '#e6c374'; // Slightly different color for updates
    } else {
      submitBtn.textContent = 'Send RSVP';
      submitBtn.style.background = '#d9b166';
    }
    
    // Scroll to the form fields on mobile
    setTimeout(() => {
      document.getElementById('rsvpFormFields').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }, 100);
  }

  function resetForm() {
    guestSelected = false;
    document.getElementById('selectedGuestId').value = '';
    document.getElementById('rsvpFormFields').style.display = 'none';
    searchResults.style.display = 'none';
  }

  // Hide search results when clicking outside
  document.addEventListener('click', function(e) {
    if (!searchInput.contains(e.target) && !searchResults.contains(e.target)) {
      searchResults.style.display = 'none';
    }
  });
</script>

<%- include('partials/footer') %>
